<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.system.billingsystem.controller.LoginController"
            prefWidth="480.0" prefHeight="420.0">

  <children>
    <VBox alignment="CENTER" spacing="16.0"
          AnchorPane.topAnchor="20.0"
          AnchorPane.bottomAnchor="20.0"
          AnchorPane.leftAnchor="20.0"
          AnchorPane.rightAnchor="20.0">

      <children>
        <Label text="Sign in" style="-fx-font-size:20px; -fx-font-weight:600;" />

        <GridPane hgap="10.0" vgap="10.0" maxWidth="380.0">
          <columnConstraints>
            <ColumnConstraints percentWidth="100.0" />
          </columnConstraints>

          <children>
            <TextField fx:id="emailField" promptText="Email" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <PasswordField fx:id="passwordField" promptText="Password" GridPane.rowIndex="1" GridPane.columnIndex="0" />

  
          </children>
        </GridPane>

        <Label fx:id="errorLabel" text="" visible="false" managed="false" style="-fx-text-fill: #b00020;" />
        <Label fx:id="successLabel" text="" visible="true" managed="false" style="-fx-text-fill: #23b000ff;" />

        <Button fx:id="loginButton" text="Sign in" maxWidth="Infinity" defaultButton="true" />

        <HBox alignment="CENTER" spacing="6.0">
          <children>
            <Label text="Don't have an account?" />
            <Button fx:id="goToSignupButton" text="Sign up" />
          </children>
        </HBox>

      </children>

      <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
      </padding>
    </VBox>
  </children>
</AnchorPane>
